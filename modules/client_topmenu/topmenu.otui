TopButton < UIButton
  size: 34 34
  background-color: #00000000

  $hover:
    opacity: 0.9

  $pressed:
    opacity: 0.5

  $checked:
    opacity: 0.6

  $disabled:
    opacity: 0.35


TopMenuPanel
  id: topMenu
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  opacity: 1
  height: 40
  background-color: #00000099

  TopMenuButtonsPanel
    id: leftButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 6
    background-color: #00000000

  TopMenuButtonsPanel
    id: leftGameButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: leftButtonsPanel.right
    margin-left: 4
    visible: false
    background-color: #00000000

  TopMenuFrameCounterLabel
    id: fpsLabel
    text-auto-resize: true
    anchors.top: parent.top
    anchors.left: leftGameButtonsPanel.right
    margin-left: 6

  TopMenuPingLabel
    id: pingLabel
    color: white
    text-auto-resize: true
    anchors.top: fpsLabel.bottom
    anchors.left: fpsLabel.left

  TopMenuButtonsPanel
    id: centerGameButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    background-color: #00000000

  TopMenuButtonsPanel
    id: rightGameButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: centerGameButtonsPanel.right
    margin-left: 4
    visible: false
    background-color: #00000000

  TopMenuButtonsPanel
    id: rightButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 6
    padding-left: 0
    opacity: 0
    background-color: #00000000
