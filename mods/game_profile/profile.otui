ProfileWindow < UIWindow
  background-color: #000000
  border-width: 1
  border-color: #3d8bc5
  focusable: true
  draggable: true
  phantom: false

ProfileWindow
  id: profileWindow
  size: 690 598
  anchors.centerIn: parent
  visible: false

  Panel
    anchors.fill: parent
    image-source: /images/ui/menu_perfil
    image-border: 0

  Panel
    anchors.fill: parent
    background-color: #000000

  Panel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 58
    background-color: #000000


    Label
      id: nameLabel
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 156
      width: 1
      height: 1
      visible: false
      text: Name

    UIWidget
      size: 18 18
      anchors.right: closeButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 138
      image-source: /images/game/others_vitoredu/lockpad

    Panel
      id: idValueBox
      anchors.right: closeButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 12
      size: 120 28
      background-color: #0a0a0a
      border-width: 1
      border-color: #2a5877

      Label
        id: value
        anchors.fill: parent
        margin-left: 6
        margin-right: 6
        text-align: center
        color: #f2fbff
        font: verdana-11px-antialised

    Button
      id: closeButton
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 12
      margin-right: 12
      size: 32 32
      text: X
      background-color: #6c2f37
      border-width: 1
      border-color: #d98b95
      color: #ffffff
      font: sans-bold-16px
      @onClick: modules.game_profile.toggle()

    Panel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 1
      background-color: #3d8bc5

  Panel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 76
    margin-left: 18
    size: 154 188
    background-color: #000000
    border-width: 1
    border-color: #2f6b96

    UIWidget
