    id: abilitiesLabel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 222
    margin-left: 34
    size: 150 36
    background-color: #00000000
    border-width: 0
    padding: 4
    text: 'Nenhuma'

  UIWidget
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 284
    margin-left: 24
    size: 99 17
    image-source: /mods/game_pokedex/assets/evolucoes_header.png
