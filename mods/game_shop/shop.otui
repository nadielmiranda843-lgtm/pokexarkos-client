      layout:
        type: verticalBox
        spacing: 8

    ScrollablePanel
      id: pokeboxListPanel
      anchors.left: parent.left
      anchors.right: pokeboxListScrollBar.left
      anchors.top: pokeboxFilterPanel.bottom
      anchors.bottom: parent.bottom
      margin-top: 10
      margin-left: 12
      margin-right: 12
      margin-bottom: 12
      vertical-scrollbar: pokeboxListScrollBar
      visible: false
      layout:
        type: verticalBox
        spacing: 8

    Label
      id: emptyStateLabel
      anchors.centerIn: parent
      width: 280
      text-align: center
      text-wrap: true
      color: #d7ecff
      font: verdana-11px-rounded
      visible: false
      text: Categoria em desenvolvimento. Em breve novos produtos aqui.
